{
  "name": "tracekit-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.13",
  "engines": {
    "node": ">=22.12.0",
    "bun": "1.3.13"
  },
  "scripts": {
    "build": "bun run --filter '*' build",
    "test": "vitest run",
    "typecheck": "bun run --filter '*' typecheck && tsc -p tsconfig.tests.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "bun run build && concurrently --kill-others --names collector,dashboard \"cargo run --locked -p tracekit-collector\" \"bun run --filter @tracekit/dashboard dev\"",
    "demo:record": "tsx examples/research-agent/src/index.ts record",
    "demo:replay": "tsx examples/research-agent/src/index.ts replay",
    "demo:failure": "tsx examples/research-agent/src/index.ts failure",
    "test:e2e": "playwright test",
    "smoke": "tsx scripts/smoke.ts",
    "bench": "tsx scripts/bench.ts",
    "check": "bun run build && bun run format:check && bun run lint && bun run typecheck && bun run test",
    "clean:data": "node scripts/clean-data.mjs",
    "bench:dashboard": "tsx scripts/bench-dashboard.ts",
    "preinstall": "node scripts/require-bun.mjs",
    "check:package-manager": "node scripts/require-bun.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.1",
    "@eslint/js": "9.39.2",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@tracekit/protocol": "workspace:*",
    "@tracekit/sdk": "workspace:*",
    "@types/node": "24.10.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "concurrently": "10.0.6",
    "eslint": "9.39.2",
    "jsdom": "27.4.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "examples/*"
  ]
}
