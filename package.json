{
  "name": "tracekit-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.tests.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "pnpm build && concurrently --kill-others --names collector,dashboard \"cargo run --locked -p tracekit-collector\" \"pnpm --filter @tracekit/dashboard dev\"",
    "demo:record": "tsx examples/research-agent/src/index.ts record",
    "demo:replay": "tsx examples/research-agent/src/index.ts replay",
    "demo:failure": "tsx examples/research-agent/src/index.ts failure",
    "test:e2e": "playwright test",
    "smoke": "tsx scripts/smoke.ts",
    "bench": "tsx scripts/bench.ts",
    "check": "pnpm build && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "clean:data": "node scripts/clean-data.mjs",
    "bench:dashboard": "tsx scripts/bench-dashboard.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.1",
    "@eslint/js": "9.39.2",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@tracekit/protocol": "workspace:*",
    "@tracekit/sdk": "workspace:*",
    "@types/node": "24.10.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "concurrently": "10.0.6",
    "eslint": "9.39.2",
    "jsdom": "27.4.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
